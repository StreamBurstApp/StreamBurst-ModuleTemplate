<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
  </ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='Debug'">
		<PackageReference Include="StreamBurst.Abstractions" Version="*-dev.*" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'!='Debug'">
		<PackageReference Include="StreamBurst.Abstractions" Version="1.0.4" />
	</ItemGroup>

	<ItemGroup>
		<None Update="manifest.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<Target Name="CopyToAppData" AfterTargets="Build" Condition="'$(Configuration)'=='Debug'">
		<MakeDir Directories="$(APPDATA)\StreamBurst\modules\StreamBurst.Module" Condition="!Exists('$(APPDATA)\StreamBurst\modules\StreamBurst.Module')" />
		<ItemGroup>
			<OutputFiles Include="$(TargetDir)**\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(OutputFiles)" DestinationFolder="$(APPDATA)\StreamBurst\modules\StreamBurst.Module\%(RecursiveDir)" SkipUnchangedFiles="true" />
	</Target>

	<ItemGroup>
		<Compile Update="Views\Module.axaml.cs">
			<DependentUpon>Module.axaml</DependentUpon>
		</Compile>
	</ItemGroup>
</Project>
